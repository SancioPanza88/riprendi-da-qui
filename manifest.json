{
  "manifest_version": 3,
  "name": "Riprendi da qui",
  "version": "6.0.0",
  "description": "Riconosce il film che stai guardando, segna dove sei arrivato e riprendi da lì. Watchlist, voti e consigli in stile Letterboxd (importa il tuo profilo), sync automatica con Letterboxd, backup su file e amici con cui guardare insieme in tempo reale.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "unlimitedStorage", "downloads", "alarms", "offscreen"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["titleparse.js", "progress.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Riprendi da qui",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
